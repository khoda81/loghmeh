{
  "name": "loghmeh",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "An independent Firefox and Chrome extension for planning University of Tehran dining reservations with your existing browser login.",
  "scripts": {
    "test": "bun test ./tests",
    "check": "svelte-check --fail-on-warnings && tsc -p tests && bun scripts/check.ts",
    "dev": "vite --config vite.config.ts --mode preview",
    "build": "vite build",
    "preview": "bun scripts/preview.ts",
    "package": "bun scripts/package.ts"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoda81/loghmeh.git"
  },
  "homepage": "https://github.com/khoda81/loghmeh",
  "bugs": {
    "url": "https://github.com/khoda81/loghmeh/issues"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "fflate": "0.8.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "1.61.0"
  }
}
